<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Version>1.0.0</Version>
    <Authors>Rahul Nagrikar</Authors>
    <Copyright>Copyright (c) 2026 Rahul Nagrikar</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Rahul2749/APILifecycle</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Rahul2749/APILifecycle</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReleaseNotes>First stable .NET 10 release: validated lifecycle policies, RFC deprecation/sunset headers, retirement and brownout enforcement, bounded BCL usage metrics, Asp.Versioning adapter, and testing helpers. Includes MVC/version-reader coverage, preserved 400/405 responses, and semantic version-key matching. See CHANGELOG.md.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Description>Lifecycle management for versioned ASP.NET Core APIs: deprecation and sunset headers, retirement enforcement, brownouts, and usage metrics.</Description>
    <PackageTags>api-versioning;deprecation;sunset;api-lifecycle;opentelemetry;aspnetcore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
